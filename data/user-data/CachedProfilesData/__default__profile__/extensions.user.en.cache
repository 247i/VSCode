ect","hiddenWhen":"resharper.canRunProject != true","languages":["csharp","razor","aspnetcorerazor","vb","fsharp"],"initialConfigurations":[{"name":"ReSharper: Launch .NET Project","type":"dotnet","request":"launch"}],"configurationSnippets":[{"label":"ReSharper: Launch .NET Project","description":"Launch and debug a project by its .csproj — the target runtime (.NET, .NET Framework, or Mono) and output are resolved automatically, and the project is built first.","body":{"name":"ReSharper: Launch .NET Project","type":"dotnet","request":"launch","projectPath":"^\"\\${workspaceFolder}/$0\""}}],"configurationAttributes":{"launch":{"properties":{"projectPath":{"type":"string","description":"Path to the .csproj of the project to launch."},"launchConfigurationId":{"type":"string","description":"Target framework and launchSettings profile to launch, as \"TargetFramework=<framework>;<profile>\"."},"args":{"description":"Command-line arguments passed to the program.","oneOf":[{"type":"string"},{"type":"array","items":{"type":"string"}}]},"env":{"type":"object","description":"Environment variables for the program, as a map of name to value."}}}}}],"breakpoints":[{"language":"csharp"},{"language":"razor"},{"language":"aspnetcorerazor"},{"language":"vb"},{"language":"fsharp"}]},"scripts":{"clean":"rimraf dist && rimraf out","preinstall":"yarn --cwd ../../../../vscode/core && yarn --cwd ../../../../vscode/core compile","build":"yarn --cwd ../../../../vscode/core compile && yarn clean && webpack --config webpack.config.ts","build:release":"yarn --cwd ../../../../vscode/core compile && yarn clean && webpack --config webpack.config.ts --mode production","update-package-json":"tsc -b ./src && ts-node --project src/tsconfig.json scripts/update-package-json.ts","update-core":"rimraf node_modules && yarn","l10n":"tsc -b ./src && ts-node scripts/update-localization-templates.ts","watch":"npm-run-all -p watch:*","watch:core":"yarn --cwd ../../../../vscode/core watch","watch:webviews":"web