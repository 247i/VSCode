E names in the SQL editor. Set to empty string to disable."},"mssqlManager.jsonXmlHighlightColor":{"type":"string","default":"#ce9178","description":"Color used for JSON/XML values in query result cells."},"mssqlManager.multipleResultSetsDisplay":{"type":"string","default":"single-view","enum":["single-view","separately"],"enumDescriptions":["Single view — all result sets displayed stacked in the results tab.","Separately — each result set shown on its own tab (Set 1, Set 2, ...)."],"description":"Controls how multiple result sets are displayed in the query results panel."},"mssqlManager.numberFormat":{"type":"string","default":"plain","enum":["plain","locale","fixed-2","fixed-4"],"enumDescriptions":["Plain — no formatting, values displayed as-is (e.g. 1234567.89)","Locale — locale-aware thousand separators (e.g. 1,234,567.89)","2 decimal places — locale separators, always 2 decimal digits (e.g. 1,234,567.89)","4 decimal places — locale separators, always 4 decimal digits (e.g. 1,234,567.8900)"],"description":"Controls how numeric values are displayed in query results."},"mssqlManager.schemaCacheValiditySeconds":{"type":"number","default":120,"minimum":5,"maximum":3600,"description":"Duration in seconds to cache database schema hash validation results. Longer values reduce database queries but may delay detection of schema changes. (Default: 120 seconds)"},"mssqlManager.queryHistorySaveOnlyUnique":{"type":"boolean","default":true,"description":"When enabled, executing the same query on the same connection updates the existing history entry instead of creating a duplicate. Different connections always create separate entries."},"mssqlManager.formatting.tabWidth":{"type":"number","default":2,"minimum":1,"maximum":8,"description":"Number of spaces used for SQL indentation."},"mssqlManager.formatting.keywordCase":{"type":"string","enum":["upper","lower","preserve"],"default":"upper","description":"Formatting: SQL keyword case."},"mssqlManager.formatting.dataTypeCase":{"type":"string","enum":["upper","lower","preserve"],"default":"upper","description":"Formatting: SQL data type case."},"mssqlManager.formatting.functionCase":{"type":"string","enum":["upper","lower","preserve"],"default":"upper","description":"Formatting: SQL function name case."},"mssqlManager.formatting.linesBetweenQueries":{"type":"number","default":1,"minimum":0,"maximum":5,"description":"Formatting: blank lines between SQL statements."},"mssqlManager.formatting.indentStyle":{"type":"string","enum":["standard","tabularLeft","tabularRight"],"default":"standard","description":"Formatting: indentation style for SQL formatting."},"mssqlManager.formatting.logicalOperatorNewline":{"type":"string","enum":["before","after"],"default":"before","description":"Formatting: place AND/OR before or after line breaks."},"mssqlManager.formatting.formatBeforeRun":{"type":"boolean","default":false,"description":"Formatting: automatically format query before execution."},"mssqlManager.dmlProtection.warnOnMissingWhere":{"type":"boolean","default":true,"description":"Show a confirmation dialog before executing UPDATE or DELETE statements that do not contain a WHERE clause."},"mssqlManager.dmlProtection.limitAffectedRows":{"type":"boolean","default":true,"description":"Before executing UPDATE or DELETE, run the statement in a rolled-back transaction to check the number of affected rows. If the count exceeds the safe threshold, a confirmation dialog is shown."},"mssqlManager.dmlProtection.maxAffectedRows":{"type":"number","default":100,"minimum":1,"description":"Maximum number of affected rows allowed without confirmation when DML row-limit protection is enabled."}}}},"scripts":{"clean:out":"node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"","build:notebook":"npm ci --prefix webview/sqlNotebook && npm run build --prefix webview/sqlNotebook","vscode:prepublish":"npm run build:notebook && npm run package","compile":"cd webview/sqlEditor-react && npm run build && cd