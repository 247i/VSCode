		"menus": {
			"explorer/context": [
				{
					"command": "csdevkit.addNewFileToFolder",
					"when": "solutionOpened && (explorerResourceIsFolder || (resourceScheme == file && resourceExtname == .csproj))",
					"group": "navigation@7"
				},
				{
					"command": "csdevkit.addNewProjectToFolder",
					"when": "explorerResourceIsFolder && solutionOpened",
					"group": "navigation@8"
				},
				{
					"command": "csdevkit.openSolution",
					"when": "resourceScheme == file && (resourceExtname == .sln || resourceExtname == .slnx || resourceExtname == .slnf)",
					"group": "navigation@9"
				},
				{
					"command": "csdevkit.revealInProjectDetails",
					"when": "resourceScheme == file && resourceExtname == .csproj && !(resourcePath in csdevkit.projectsOutsideSolution)",
					"group": "navigation@21"
				},
				{
					"command": "csdevkit.addProjectToSolutionFromExplorer",
					"when": "resourceScheme == file && resourceExtname == .csproj && solutionOpened && !generatedSlnOutsideWorkspace && resourcePath in csdevkit.projectsOutsideSolution",
					"group": "navigation@0"
				},
				{
					"command": "csdevkit.revealInProjectDetails",
					"when": "explorerResourceIsFolder && resourcePath in csdevkit.foldersWithProjects",
					"group": "navigation@21"
				},
				{
					"command": "csdevkit.manageUserSecrets",
					"when": "(resourceScheme == file && resourceExtname == .csproj) || (explorerResourceIsFolder && resourcePath in csdevkit.foldersWithProjects)",
					"group": "2_csdevkit_3_project@5"
				},
				{
					"command": "csdevkit.addProjectReference",
					"when": "resourceScheme == file && resourceExtname == .csproj && !(resourcePath in csdevkit.projectsOutsideSolution)",
					"group": "2_csdevkit_3_project@1"
				},
				{
					"command": "csdevkit.removeProjectReference",
					"when": "resourceScheme == file && resourceExtname == .csproj && !(resourcePath in csdevkit.projectsOutsideSolution)",
					"group": "2_csdevkit_3_project@2"
				},
				{
					"submenu": "csdevkit.nuget",
					"when": "(resourceScheme == file && resourceExtname == .csproj) || (explorerResourceIsFolder && resourcePath in csdevkit.foldersWithProjects)",
					"group": "2_csdevkit_3_project@3"
				},
				{
					"command": "csdevkit.addProjectReference",
