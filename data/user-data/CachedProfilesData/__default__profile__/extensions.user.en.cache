nochrome":{"description":"test project, hero, normal (monochrome)","default":{"fontPath":"./media/fonts/solution-icons-hero-normal-v1.woff","fontCharacter":"\\E017"}},"csharp-project-function-hero-normal-monochrome":{"description":"function project, hero, normal (monochrome)","default":{"fontPath":"./media/fonts/solution-icons-hero-normal-v1.woff","fontCharacter":"\\E019"}},"csharp-project-desktop-hero-normal-monochrome":{"description":"desktop project, hero, normal (monochrome)","default":{"fontPath":"./media/fonts/solution-icons-hero-normal-v1.woff","fontCharacter":"\\E01C"}},"csharp-project-csharp-hero-medium-monochrome":{"description":"csharp project, hero, medium (monochrome)","default":{"fontPath":"./media/fonts/solution-icons-hero-medium-v1.woff","fontCharacter":"\\E011"}},"csharp-project-web-hero-medium-monochrome":{"description":"web project, hero, medium (monochrome)","default":{"fontPath":"./media/fonts/solution-icons-hero-medium-v1.woff","fontCharacter":"\\E013"}},"csharp-project-console-hero-medium-monochrome":{"description":"console project, hero, medium (monochrome)","default":{"fontPath":"./media/fonts/solution-icons-hero-medium-v1.woff","fontCharacter":"\\E015"}},"csharp-project-test-hero-medium-monochrome":{"description":"test project, hero, medium (monochrome)","default":{"fontPath":"./media/fonts/solution-icons-hero-medium-v1.woff","fontCharacter":"\\E017"}},"csharp-project-function-hero-medium-monochrome":{"description":"function project, hero, medium (monochrome)","default":{"fontPath":"./media/fonts/solution-icons-hero-medium-v1.woff","fontCharacter":"\\E019"}},"csharp-project-desktop-hero-medium-monochrome":{"description":"desktop project, hero, medium (monochrome)","default":{"fontPath":"./media/fonts/solution-icons-hero-medium-v1.woff","fontCharacter":"\\E01C"}},"csharp-project-csharp-hero-large-monochrome":{"description":"csharp project, hero, large (monochrome)","default":{"fontPath":"./media/fonts/solution-icons-hero-large-v1.woff","font