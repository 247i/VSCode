 depth processed per file."}}}},"scripts":{"vscode:prepublish":"npm run compile","compile":"tsc -p ./","watch":"tsc -watch -p ./","package":"node --require ./scripts/polyfill-file.js ./node_modules/@vscode/vsce/vsce package"},"devDependencies":{"@types/node":"^18.19.0","@types/vscode":"^1.75.0","@vscode/vsce":"^2.22.0","typescript":"^5.4.0"}},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCode/data/extensions/talhakhalil.preprocessor-rainbow-0.1.0","scheme":"file"},"isBuiltin":false,"targetPlatform":"undefined","publisherDisplayName":"Talha Khalil","metadata":{"installedTimestamp":1787668585307,"pinned":false,"source":"gallery","id":"02e8c2d4-ac6d-47cd-85ae-70cf37dd74e9","publisherId":"55314c1d-efda-4148-b164-749c766c89d3","publisherDisplayName":"Talha Khalil","targetPlatform":"undefined","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":16834},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"icsharpcode.ilspy-vscode","uuid":"e71e3bdc-dd75-4005-bc34-5ef5838c84ad"},"manifest":{"name":"ilspy-vscode","displayName":"ilspy-vscode","description":"Decompile MSIL assemblies - support for full framework, .NET Core and .NET Standard","version":"1.0.0","icon":"resources/ILSpy-vscode-marketplace-icon.png","publisher":"icsharpcode","private":true,"license":"SEE LICENSE","homepage":"https://github.com/icsharpcode/ilspy-vscode/tree/master/vscode-extension","bugs":"https://github.com/icsharpcode/ilspy-vscode/issues","repository":{"type":"git","url":"https://github.com/icsharpcode/ilspy-vscode"},"engines":{"vscode":"^1.110.0"},"categories":["Other"],"activationEvents":["onStartupFinished"],"main":"./dist/extension.js","contributes":{"configuration":[{"title":"ILSpy","properties":{"ilspy.defaultOutputLanguage":{"description":"Defines to which language or language variant ILSpy will decompile assemblies by default. Note that you can choose a different language for a specific view later.","type":"string","default":"C# 14.0 / VS 2026","enum":["C# 14.0 / VS 2026","C# 13.0 / VS 2022.12","C# 12.0 / VS 2022.8","C# 11.0 / VS 2022.4","C# 10.0 / VS 2022","C# 9.0 / VS 2019.8","C# 8.0 / VS 2019","C# 7.3 / VS 2017.7","C# 7.2 / VS 2017.4","C# 7.1 / VS 2017.3","C# 7.0 / VS 2017","C# 6.0 / VS 2015","C# 5.0 / VS 2012","C# 4.0 / VS 2010","C# 3.0 / VS 2008","C# 2.0 / VS 2005","C# 1.0 / VS .NET","IL"],"enumDescriptions":["Decompile to C# 14.0 by default","Decompile to C# 13.0 by default","Decompile to C# 12.0 by default","Decompile to C# 11.0 by default","Decompile to C# 10.0 by default","Decompile to C# 9.0 by default","Decompile to C# 8.0 by default","Decompile to C# 7.3 by default","Decompile to C# 7.2 by default","Decompile to C# 7.1 by default","Decompile to C# 7.0 by default","Decompile to C# 6.0 by default","Decompile to C# 5.0 by default","Decompile to C# 4.0 by default","Decompile to C# 3.0 by default","Decompile to C# 2.0 by default","Decompile to C# 1.0 by default","Decompile to readable IL instructions by default"]},"ilspy.loadPreviousAssemblies":{"description":"If activated, the list of loaded assemblies is stored with current workspace and is restored on re-opening. This doesn't apply for temporarily auto-loaded dependencies.","type":"boolean","default":"true"},"ilspy.autoLoadDependencies":{"description":"If activated, dependency assemblies are temporarily added to assembly tree on demand.","type":"boolean","default":"true"},"ilspy.showCompilerGeneratedSymbols":{"description":"If activated, shows compiler-generated symbols.","type":"boolean","default":"false"}}}],"viewsContainers":{"panel":[{"id":"ilspySearchResultsContainer","title":"ILSpy: Search Results","icon":"resources/il-spy-modern-icon.svg"},{"id":"ilspyAnalyzeResultsContainer","title":"ILSpy: Analyze","icon":"resources/il-spy-modern-icon.svg"}]},"views":{"explorer":[{"id":"ilspyDecompiledMembers","name":"ILSpy: Assemblies","when":"ilspy.backendAvailable","icon":"resources/il-spy-modern-icon.svg"}],"ilspySearchResultsContainer":[{"id":"ilspySearchResultsContainer","name":"ILSpy: Search Results","when":"ilspy.searchResultsToShow","icon":"resources/il-spy-modern-icon.svg"}],"ilspyAnalyzeResultsContainer":[{"id":"ilspyAnalyzeResultsContainer","name":"ILSpy: Analyze","when":"ilspy.analyzeResultsToShow","icon":"resources/il-spy-modern-icon.svg"}]},"viewsWelcome":[{"view":"ilspyDecompiledMembers","contents":"No assemblies selected yet\n[Add assembly from workspace](command:ilspy.decompileAssemblyInWorkspace)\n[Pick assembly from file system](command:ilspy.decompileAssemblyViaDialog)\n\nTake the [Feature Tour](https://github.com/icsharpcode/ilspy-vscode/wiki/Feature-Tour)","when":"ilspy.backendAvailable"}],"commands":[{"command":"ilspy.decompileSelectedAssembly","title":"Decompile selected assembly","category":"ILSpy"},{"command":"ilspy.decompileAssemblyInWorkspace","title":"Add assembly or package from workspace","category":"ILSpy"},{"command":"ilspy.decompileAssemblyViaDialog","title":"Pick assembly or package from file system","category":"ILSpy"},{"command":"ilspy.unloadAssembly","title":"Unload","category":"ILSpy","icon":"$(close)"},{"command":"ilspy.reloadAssembly","title":"Reload","category":"ILSpy","icon":"$(refresh)"},{"command":"ilspy.selectOutputLanguage","title":"Select output language","category":"ILSpy"},{"command":"ilspy.search","title":"Search in Decompiled Assemblies","category":"ILSpy","icon":"$(search-view-icon)"},{"command":"ilspy.searchEditorSelection","title":"Search with ILSpy","category":"ILSpy","icon":"$(search-view-icon)"},{"command":"ilspy.analyze","title":"Analyze Element","category":"ILSpy","icon":"$(search-view-icon)"},{"command":"ilspy.export","title":"Export Decompiled Code...","category":"ILSpy","icon":"$(save-all)"}],"menus":{"explorer/context":[{"command":"ilspy.decompileSelectedAssembly","group":"navigation","when":"resourceExtname == .dll || resourceExtname == .exe || resourceExtname == .winmd || resourceExtname == .netmodule || resourceExtname == .wasm"}],"editor/context":[{"command":"ilspy.searchEditorSelection","when":"ilspy.backendAvailable && ilspy.treeWithNodes"}],"view/title":[{"submenu":"ilspy/view/assemblytree/add","when":"view == ilspyDecompiledMembers","group":"navigation"},{"command":"ilspy.search","when":"view == ilspyDecompiledMembers && ilspy.treeWithNodes","group":"navigation"}],"ilspy/view/assemblytree/add":[{"command":"ilspy.decompileAssemblyInWorkspace","when":"view == ilspyDecompiledMembers"},{"command":"ilspy.decompileAssemblyViaDialog","when":"view == ilspyDecompiledMembers"}],"view/item/context":[{"command":"ilspy.analyze","when":"(view == ilspyDecompiledMembers || view == ilspySearchResultsContainer || view == ilspyAnalyzeResultsContainer) && viewItem =~ /#analyze/","group":"assembly@0"},{"command":"ilspy.reloadAssembly","when":"view == ilspyDecompiledMembers && viewItem =~ /#manageRootEntries/","group":"assembly@1"},{"command":"ilspy.export","when":"view == ilspyDecompiledMembers && viewItem =~ /#export/","group":"assembly@2"},{"command":"ilspy.unloadAssembly","when":"view == ilspyDecompiledMembers && viewItem =~ /#manageRootEntries/","group":"assembly@3"},{"command":"ilspy.analyze","when":"(view == ilspyDecompiledMembers || view == ilspySearchResultsContainer || view == ilspyAnalyzeResultsContainer) && viewItem =~ /#analyze/","group":"inline@0"},{"command":"ilspy.reloadAssembly","when":"view == ilspyDecompiledMembers && viewItem =~ /#manageRootEntries/","group":"inline@1"},{"command":"ilspy.export","when":"view == ilspyDecompiledMembers && viewItem =~ /#export/","group":"inline@2"},{"command":"ilspy.unloadAssembly","when":"view == ilspyDecompiledMembers && viewItem =~ /#manageRootEntries/","group":"inline@3"}],"commandPalette":[{"command":"ilspy.decompileAssemblyInWorkspace","when":"ilspy.backendAvailable"},{"command":"ilspy.decompileAssemblyViaDialog","when":"ilspy.backendAvailable"},{"command":"ilspy.selectOutputLanguage","when":"resourceScheme == ilspy"},{"command":"ilspy.search","when":"ilspy.backendAvailable && ilspy.treeWithNodes"},{"command":"ilspy.decompileSelectedAssembly","when":"false"},{"command":"ilspy.searchEditorSelection","when":"false"},{"command":"ilspy.analyze","when":"false"},{"command":"ilspy.reloadAssembly","when":"false"},{"command":"ilspy.unloadAssembly","when":"false"},{"command":"ilspy.export","when":"false"}]},"submenus":[{"id":"ilspy/view/assemblytree/add","label":"Add Assembly","icon":"$(add)"}],"colors":[{"id":"ilspy.autoLoadedAssemblyTextForeground","description":"Text color of auto-loaded assemblies","defaults":{"dark":"#4682B4","light":"#4682B4","highContrast":"#4682B4"}}],"languageModelTools":[{"name":"add_loaded_assembly","tags":["ilspy","assemblies","load"],"toolReferenceName":"ilspy-add-assembly","displayName":"Add assembly or NuGet package to ILSpy","modelDescription":"Adds one assembly or NuGet package file to the set of assemblies currently loaded in ILSpy so that it can be searched, analyzed, decompiled, and exported.","userDescription":"Add one assembly or NuGet package file to ILSpy","canBeReferencedInPrompt":true,"icon":"$(add)","inputSchema":{"type":"object","required":["assemblyPath"],"properties":{"assemblyPath":{"type":"string","description":"Absolute file system path of the assembly to add to ILSpy"}}}},{"name":"remove_loaded_assembly","tags":["ilspy","assemblies","unload"],"toolReferenceName":"ilspy-remove-assembly","displayName":"Remove assembly or NuGet package from ILSpy","modelDescription":"Removes one currently loaded assembly or NuGet package from ILSpy. Prefer assemblyPath for exact targeting; assemblyName can be used when it uniquely identifies a loaded assembly.","userDescription":"Remove one loaded assembly or NuGet package from ILSpy","canBeReferencedInPrompt":true,"icon":"$(close)","inputSchema":{"type":"object","properties":{"assemblyPath":{"type":"string","description":"Absolute file system path of the loaded assembly or NuGet package to remove"},"assemblyName":{"type":"string","description":"Assembly file name or simple assembly name to remove when it is unique among loaded assemblies"}}}},{"name":"list_loaded_assemblies","tags":["ilspy","assemblies"],"toolReferenceName":"ilspy-list-assemblies","displayName":"List loaded ILSpy assemblies","modelDescription":"Returns the assemblies or NuGet packages currently loaded in ILSpy, including their names and full paths. Use this before decompilation or analysis when you need to know what ILSpy can already inspect.","userDescription":"List the assemblies or NuGet packages currently loaded in ILSpy","canBeReferencedInPrompt":true,"icon":"$(files)","inputSchema":{"type":"object","properties":{}}},{"name":"decompile_symbol","tags":["ilspy","decompile"],"toolReferenceName":"ilspy-decompile-symbol","displayName":"Decompile symbol with ILSpy","modelDescription":"Searches the currently loaded ILSpy assemblies for a .NET symbol such as a type, member, or namespace, then returns the decompiled source code for the matching symbol or symbols. Use assemblyPath or assemblyName to disambiguate when the same symbol exists in multiple assemblies.","userDescription":"Decompile a .NET symbol from the assemblies currently loaded in ILSpy","canBeReferencedInPrompt":true,"icon":"$(files)","inputSchema":{"type":"object","required":["symbol"],"properties":{"symbol":{"type":"string","description":"Name of the .NET symbol to decompile. A fully qualified name is preferred when available"},"assemblyPath":{"type":"string","description":"Optional absolute assembly path used to narrow the symbol search to one loaded assembly"},"assemblyName":{"type":"string","description":"Optional assembly file name or simple assembly name used to narrow the symbol search"},"outputLanguage":{"type":"string","description":"Optional ILSpy output language. When omitted, the extension's current default output language is used"}}}},{"name":"decompile_node","tags":["ilspy","decompile","tree","nodes"],"toolReferenceName":"ilspy-decompile-node","displayName":"Decompile ILSpy tree node","modelDescription":"Decompiles one specific ILSpy tree node using its exact nodeMetadata payload. Use this when you already have a concrete node from list_nodes or another ILSpy tool result, especially for non-symbol nodes such as references, resources, or other tree entries that are not best addressed by symbol search.","userDescription":"Decompile one specific ILSpy tree node","canBeReferencedInPrompt":true,"icon":"$(files)","inputSchema":{"type":"object","required":["nodeMetadata"],"properties":{"nodeMetadata":{"type":"object","description":"Exact ILSpy node metadata, typically copied verbatim from the nodeMetadata field returned by list_nodes or another ILSpy tool result","required":["assemblyPath","type","name","symbolToken","parentSymbolToken","availableCommands"],"properties":{"assemblyPath":{"type":"string","description":"Assembly path associated with the node"},"type":{"type":"integer","description":"Numeric ILSpy node type enum value"},"name":{"type":"string","description":"Node name from ILSpy metadata"},"bundledAssemblyName":{"type":"string","description":"Optional bundled assembly name for package-backed nodes"},"symbolToken":{"type":"integer","description":"Node symbol token from ILSpy metadata"},"parentSymbolToken":{"type":"integer","description":"Parent symbol token from ILSpy metadata"},"subType":{"type":"string","description":"Optional ILSpy node subtype"},"availableCommands":{"type":"integer","description":"Bitmask of commands ILSpy reports as available for the node"}}},"outputLanguage":{"type":"string","description":"Optional ILSpy output language. When omitted, the extension's current default output language is used"}}}},{"name":"list_nodes","tags":["ilspy","tree","nodes"],"toolReferenceName":"ilspy-list-nodes","displayName":"List ILSpy nodes","modelDescription":"Lists nodes from ILSpy's assembly tree. With no input it returns the root nodes, which are usually the loaded assemblies. Prefer passing exact nodeMetadata from a prior list_nodes result to navigate to the next level of any tree node. Symbol or assembly inputs are still supported as shortcuts for choosing the first target. Results include exact nodeMetadata for further tree navigation or decompilation.","userDescription":"List ILSpy assembly tree nodes","canBeReferencedInPrompt":true,"icon":"$(list-tree)","inputSchema":{"type":"object","properties":{"nodeMetadata":{"type":"object","description":"Exact ILSpy node metadata, typically copied verbatim from the nodeMetadata field returned by list_nodes or another ILSpy tool result. Prefer this for navigating deeper into the tree from any node type.","required":["assemblyPath","type","name","symbolToken","parentSymbolToken","availableCommands"],"properties":{"assemblyPath":{"type":"string","description":"Assembly path associated with the node"},"type":{"type":"integer","description":"Numeric ILSpy node type enum value"},"name":{"type":"string","description":"Node name from ILSpy metadata"},"bundledAssemblyName":{"type":"string","description":"Optional bundled assembly name for package-backed nodes"},"symbolToken":{"type":"integer","description":"Node symbol token from ILSpy metadata"},"parentSymbolToken":{"type":"integer","description":"Parent symbol token from ILSpy metadata"},"subType":{"type":"string","description":"Optional ILSpy node subtype"},"availableCommands":{"type":"integer","description":"Bitmask of commands ILSpy reports as available for the node"}}},"symbol":{"type":"string","description":"Optional symbol whose direct children should be listed when nodeMetadata is not provided"},"assemblyPath":{"type":"string","description":"Optional absolute assembly path whose direct child nodes should be listed, or used to disambiguate a symbol when nodeMetadata is not provided"},"assemblyName":{"type":"string","description":"Optional assembly file name or simple assembly name whose direct child nodes should be listed, or used to disambiguate a symbol when nodeMetadata is not provided"}}}},{"name":"search_decompiled_symbols","tags":["ilspy","search","symbols"],"toolReferenceName":"ilspy-search-symbols","displayName":"Search loaded ILSpy symbols","modelDescription":"Searches the symbols in assemblies currently loaded in ILSpy and returns matching nodes with type, assembly path, display information, and exact nodeMetadata. Use it to discover exact symbol names before decompiling or analyzing them, or to obtain nodeMetadata for decompile_node.","userDescription":"Search the symbols in assemblies currently loaded in ILSpy","canBeReferencedInPrompt":true,"icon":"$(search-view-icon)","inputSchema":{"type":"object","required":["term"],"properties":{"term":{"type":"string","description":"Text to search for in loaded assemblies"},"assemblyPath":{"type":"string","description":"Optional absolute assembly path used to restrict the search to one loaded assembly"},"assemblyName":{"type":"string","description":"Optional assembly file name or simple assembly name used to restrict the search"}}}},{"name":"analyze_symbol","tags":["ilspy","analyze"],"toolReferenceName":"ilspy-analyze-symbol","displayName":"Analyze symbol with ILSpy","modelDescription":"Runs ILSpy's analyze request for a loaded symbol or assembly and returns the resulting analyzer nodes. Use it to inspect usages, derived types, base types, or other analysis views exposed by ILSpy.","userDescription":"Analyze a loaded symbol or assembly with ILSpy","canBeReferencedInPrompt":true,"icon":"$(search-view-icon)","inputSchema":{"type":"object","properties":{"symbol":{"type":"string","description":"Optional symbol to analyze. If omitted, assemblyPath or assemblyName must identify a loaded assembly"},"assemblyPath":{"type":"string","description":"Optional absolute assembly path used to target or disambiguate the analysis request"},"assemblyName":{"type":"string","description":"Optional assembly file name or simple assembly name used to target or disambiguate the analysis request"}}}},{"name":"export_decompiled_code","tags":["ilspy","export","decompile"],"toolReferenceName":"ilspy-export-code","displayName":"Export decompiled ILSpy code","modelDescription":"Exports the decompiled output of a loaded ILSpy node to a directory on disk. The target can be an assembly or another exportable symbol. Use assemblyPath or assemblyName to target a loaded assembly directly, or provide a symbol and optionally narrow it by assembly.","userDescription":"Export decompiled ILSpy output to a directory on disk","canBeReferencedInPrompt":true,"icon":"$(export)","inputSchema":{"type":"object","required":["outputDirectory"],"properties":{"symbol":{"type":"string","description":"Optional export target symbol. If omitted, assemblyPath or assemblyName must identify a loaded assembly"},"assemblyPath":{"type":"string","description":"Optional absolute assembly path used to target or disambiguate the export"},"assemblyName":{"type":"string","description":"Optional assembly file name or simple assembly name used to target or disambiguate the export"},"outputDirectory":{"type":"string","description":"Absolute path of the directory where ILSpy should write the exported files"},"outputLanguage":{"type":"string","description":"Optional ILSpy output language. When omitted, the extension's current default output language is used"},"includeCompilerGenerated":{"type":"boolean","description":"Optional override for whether compiler-generated members should be included in the export"}}}}],"languages":[{"id":"ilspy-code-cs","aliases":["ILSpy (C#)"],"icon":{"light":"resources/il-spy-modern-icon.svg","dark":"resources/il-spy-modern-icon-dark.svg"}},{"id":"ilspy-code-il","aliases":["ILSpy (IL)"],"icon":{"light":"resources/il-spy-modern-icon.svg","dark":"resources/il-spy-modern-icon-dark.svg"}}],"grammars":[{"language":"ilspy-code-cs","scopeName":"source.ilspy-code-cs","path":"resources/ilspy-code-cs.tmLanguage.json"}]},"scripts":{"vscode:prepublish":"pnpm package","package":"webpack --mode production --devtool hidden-source-map","build:vsix":"vsce package --no-dependencies","compile":"webpack --mode development","watch":"webpack --mode development --watch","pretest":"pnpm compile && pnpm lint","lint":"eslint src --ext ts","test":"node ./out/test/runTest.js","test:unit":"vitest src --run"},"dependencies":{"ansi-regex":"6.2.2","brace-expansion":"5.0.6","chai":"6.2.2","os":"0.1.2","path":"0.12.7","temp-dir":"3.0.0","terser":"5.47.1","vscode-languageclient":"9.0.1"},"devDependencies":{"@types/chai":"5.2.3","@types/mocha":"10.0.10","@types/node":"22.15.31","@types/vscode":"1.110.0","@typescript-eslint/eslint-plugin":"8.59.3","@typescript-eslint/parser":"8.59.3","@vscode/test-electron":"2.5.2","@vscode/vsce":"3.9.1","eslint":"10.4.0","glob":"13.0.6","minimist":"1.2.8","mocha":"11.7.5","terser-webpack-plugin":"5.6.0","ts-loader":"9.5.7","typescript":"6.0.3","vitest":"4.1.6","webpack":"5.106.2","webpack-cli":"7.0.2"},"extensionDependencies":["ms-dotnettools.vscode-dotnet-runtime"],"packageManager":"pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCode/data/extensions/icsharpcode.ilspy-vscode-1.0.0","scheme":"file"},"isBuiltin":false,"targetPlatform":"undefined","publisherDisplayName":"SharpDevelop Team","metadata":{"installedTimestamp":1787668656090,"pinned":false,"source":"gallery","id":"e71e3bdc-dd75-4005-bc34-5ef5838c84ad","publisherId":"b70c48a1-8bf6-4654-9c0f-5f04529311da","publisherDisplayName":"SharpDevelop Team","targetPlatform":"undefined","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":10988005},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"jakubkozera.github-copilot-code-reviewer","uuid":"1fbf2c3e-40ca-4ad9-9445-7c0d1c8a63b3"},"manifest":{"name":"github-copilot-code-reviewer","displayName":"Github Copilot Code Reviewer","description":"Review source code changes in Git using GitHub Copilot","publisher":"jakubkozera","version":"0.22.2","repository":{"type":"git","url":"https://github.com/jakubkozera/vsc-copilot-code-review"},"engines":{"vscode":"^1.99.1"},"categories":["AI","Chat","Machine Learning","Programming Languages"],"keywords":["ai","chat","copilot","git","review"],"icon":"images/icon.png","license":"SEE LICENSE IN LICENSE","activationEvents":[],"main":"./out/extension.js","enabledApiProposals":[],"contributes":{"commands":[{"command":"codeReview.selectChatModel","title":"Select Chat Model","category":"codeReview"},{"command":"codeReview.openCodeReviewPanel","title":"Open Code Review Panel","category":"codeReview"},{"command":"codeReview.refreshCodeReview","title":"Refresh","icon":"$(refresh)"},{"command":"codeReview.reviewCommittedChanges","title":"Review Committed Changes","icon":"$(git-commit)"},{"command":"codeReview.reviewAllChanges","title":"Review All Changes","icon":"$(git-branch)"},{"command":"codeReview.nextComment","title":"Next Comment","category":"codeReview","icon":"$(arrow-right)"},{"command":"codeReview.previousComment","title":"Previous Comment","category":"codeReview","icon":"$(arrow-left)"},{"command":"codeReview.applyCurrentAdjustment","title":"Apply Fix","category":"codeReview","icon":"$(wand)"}],"chatParticipants":[{"id":"codereview","name":"codereview","fullName":"Github Copilot Code Reviewer","description":"Review source code changes","isSticky":false,"commands":[{"name":"review","description":"Review changes between two branches, commits, or tags.  You can specify git refs using e.g. `/review develop main`, or omit the second or both arguments to select refs interactively."},{"name":"branch","description":"Review changes between two branches."},{"name":"commit","description":"Review changes in a single commit."}]}],"languageModelTools":[{"name":"review","displayName":"Review source code changes in Git using AI","modelDescription":"Reviews source code changes in Git using AI. Use this tool to review any changes on the `target` ref (compared to `base`) to discover potential issues. Returns a list of review comments with file names, line numbers, and severity.","canBeReferencedInPrompt":true,"toolReferenceName":"review","icon":"images/icon.png","inputSchema":{"type":"object","properties":{"target":{"type":"string","description":"Target git ref (branch, commit, or tag) to review. (e.g. 'main', 'abc1234', 'v0.1.0', 'HEAD')"},"base":{"type":"string","description":"Base git ref (branch, commit, or tag) to compare against. (e.g. 'origin/main', 'abc1235', 'v0.0.9', 'HEAD~1')"}},"required":["target","base"]}},{"name":"reviewStaged","displayName":"Review staged changes in Git using AI","modelDescription":"Reviews staged changes in Git using AI. Use this tool to review changes that have been staged with `git add` but not yet committed. Returns a list of review comments with file names, line numbers, and severity.","canBeReferencedInPrompt":true,"toolReferenceName":"reviewStaged","icon":"images/icon.png","inputSchema":{"type":"object","properties":{"changeDescription":{"type":"string","description":"Description of what the changes to review are expected to implement. Use this to provide context for the review and be explicit about requirements."}}}},{"name":"reviewUnstaged","displayName":"Review unstaged changes in Git using AI","modelDescription":"Reviews unstaged changes in Git using AI. Use this tool to review changes in your working directory that haven't been staged yet. You can use this to check your work after completing a change requested by the user. Returns a list of review comments with file names, line numbers, and severity.","canBeReferencedInPrompt":true,"toolReferenceName":"reviewUnstaged","icon":"images/icon.png","inputSchema":{"type":"object","properties":{"changeDescription":{"type":"string","description":"Description of what the changes to review are expected to implement. Use this to provide context for the review and be explicit about requirements."}}}}],"views":{"scm":[{"id":"codeReview.codeReview","name":"Copilot Code Review","when":"scmProvider == git","type":"webview"}]},"viewsContainers":{"activitybar":[]},"menus":{"view/title":[{"command":"codeReview.refreshCodeReview","when":"view == codeReview.codeReview","group":"navigation"}],"comments/commentThread/context":[{"command":"codeReview.previousComment","when":"commentThread == codeReview-review","group":"navigation@1","icon":"$(arrow-left)"},{"command":"codeReview.nextComment","when":"commentThread == codeReview-review","group":"navigation@2","icon":"$(arrow-right)"},{"command":"codeReview.applyCurrentAdjustment","when":"commentThread == codeReview-review","group":"navigation@3","icon":"$(wand)"}],"comments/commentThread/title":[{"command":"codeReview.previousComment","when":"commentThread == codeReview-review","group":"navigation@1","icon":"$(arrow-left)"},{"command":"codeReview.nextComment","when":"commentThread == codeReview-review","group":"navigation@2","icon":"$(arrow-right)"},{"command":"codeReview.applyCurrentAdjustment","when":"commentThread == codeReview-review","group":"navigation@3","icon":"$(wand)"}]},"keybindings":[{"command":"codeReview.nextComment","key":"ctrl+shift+n","mac":"cmd+shift+n","when":"commentController == codeReview-comments"},{"command":"codeReview.previousComment","key":"ctrl+shift+b","mac":"cmd+shift+b","when":"commentController == codeReview-comments"}],"configuration":{"title":"codeReview","properties":{"codeReview.minSeverity":{"type":"number","default":2,"description":"Suppress comments with severity lower than the configured value. (1 to show all issues)","minimum":1,"maximum":5},"codeReview.customPrompt":{"type":"string","default":"","description":"Add custom text to the review prompt. For example, \"- In the final JSON output, use Spanish for the  `comment` field.\"","editPresentation":"multilineText"},"codeReview.exclude":{"type":"array","default":["package-lock.json","yarn.lock","pnpm-lock.yaml","*.min.js"],"items":{"type":"string"},"description":"Exclude paths from review using glob patterns. Binary files are not reviewed and do not need to be excluded."},"codeReview.enableDebugOutput":{"type":"boolean","default":false,"description":"Log debug output to Output Panel > codeReview."},"codeReview.chatModel":{"type":"string","default":"gpt-4o","markdownDescription":"Chat model ID to use for generating review comments. Note that non-default models may not be available, may require changes to the [Copilot settings](https://github.com/settings/copilot), or have stricter rate limits. (EXPERIMENTAL). Use the 'codeReview: Select Chat Model' command to choose from available models."},"codeReview.mergeFileReviewRequests":{"type":"boolean","default":true,"description":"Review changes for multiple files in one request. This improves the model's understanding of the context of individual changes and speeds up reviews. Disabling this will lose these advantages, but can be useful for a very detailed line-by-line review."},"codeReview.maxInputTokensFraction":{"type":"number","default":0.95,"description":"Fraction of the chat model's input token limit to use for requests. Lower values may increase quality of e.g. function level comments, but reduce the available context; higher values may improve the models understanding on how different changes relate to each other. The maximum allowed value is 0.95 to avoid token limit errors.","minimum":0.05,"maximum":0.95}}}},"scripts":{"preinstall":"npx only-allow pnpm","check-exclusive":"ps aux | grep -v grep | grep -q 'esbuild.*--watch' && echo 'esbuild --watch running, aborting!' && exit 1 || exit 0","vscode:prepublish":"pnpm check-exclusive && rm -rf ./out && pnpm esbuild-base --minify --pure:console.debug","esbuild-base":"esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --define:__GIT_VERSION__=\\\"$GIT_VERSION\\\"","esbuild":"pnpm esbuild-base --sourcemap","watch":"pnpm esbuild-base --sourcemap --watch","dev":"GIT_VERSION=$(git describe  --tags --long) pnpm build","build":"npx vsce package --no-dependencies","lint":"tsc --noEmit && eslint src && prettier src --check","test":"vitest run","coverage":"vitest run --coverage","checkall":"pnpm test && pnpm lint && pnpm build"},"devDependencies":{"@eslint/js":"^9.31.0","@types/node":"22.x","@types/vscode":"^1.99.1","@vitest/coverage-v8":"^3.2.4","@vscode/vsce":"^3.6.0","esbuild":"^0.25.6","eslint":"^9.31.0","prettier":"^3.6.2","typescript":"^5.8.3","typescript-eslint":"^8.36.0","vitest":"^3.2.4"},"dependencies":{"fastest-levenshtein":"^1.0.16","jsonc-parser":"^3.3.1","minimatch":"^10.0.3","simple-git":"^3.28.0"},"extensionDependencies":["github.copilot-chat"],"pnpm":{"overrides":{}},"originalEnabledApiProposals":[]},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCode/data/extensions/jakubkozera.github-copilot-code-reviewer-0.22.2","scheme":"file"},"isBuiltin":false,"targetPlatform":"undefined","publisherDisplayName":"Jakub Kozera","metadata":{"installedTimestamp":1787668784046,"pinned":false,"source":"gallery","id":"1fbf2c3e-40ca-4ad9-9445-7c0d1c8a63b3","publisherId":"fbc496a1-f6ff-43dd-a499-419c8f186962","publisherDisplayName":"Jakub Kozera","targetPlatform":"undefined","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":6339579},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"se-dev-pion.rainbow-struct-field-tags","uuid":"1a23e0d5-8903-4c45-96dc-78a6dd9a3e10"},"manifest":{"name":"rainbow-struct-field-tags","displayName":"Rainbow Struct Field Tags","description":"Highlighting struct field tags in Go to make it easier to read.","version":"0.4.0","icon":"./assets/logo.png","publisher":"se-dev-pion","repository":"https://github.com/se-dev-pion/rainbow-struct-field-tags","engines":{"vscode":"^1.85.2"},"categories":["Other"],"act