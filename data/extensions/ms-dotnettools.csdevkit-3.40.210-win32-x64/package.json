	"scripts": {
		"vscode:prepublish": "yarn run package && dotnet build tools/msbuild/signJs -v:normal",
		"build-native": "node tools/build-native.js",
		"compile": "yarn build-native && webpack",
		"watch": "yarn build-native && webpack --watch",
		"package": "yarn build-native && webpack --mode production --devtool hidden-source-map",
		"compile-tests": "tsc",
		"watch-tests": "tsc -w",
		"lint": "eslint src",
