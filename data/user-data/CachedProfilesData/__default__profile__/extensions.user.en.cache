"webpack --watch","package":"webpack --mode production --devtool hidden-source-map","build-server":"dotnet publish ../csharp-dev-tools-lsp/server/CsharpDevTools.Roslyn.Server/CsharpDevTools.Roslyn.Server.csproj -c Release -p:AssetsPath=%cd%/extension/bin/ && dotnet publish ../csharp-dev-tools-lsp/server/CsharpDevTools.Debugging.Mono/CsharpDevTools.Debugging.Mono.csproj -c Release -p:AssetsPath=%cd%/extension/bin/","build-notebook-host":"dotnet publish ../csharp-dev-tools-lsp/host/CSharpNotebook.Host/CSharpNotebook.Host.csproj -c Debug -o host/CSharpNotebook.Host/bin/Debug/net8.0","build-webviews":"cd webviews && npm ci && npm run build","watch-webviews":"cd webviews && npm run dev","test-webviews":"cd webviews && npm test","build-speedscope":"cd external/speedscope && npm install && npm run build-release -- --outdir \"dist\" --protocol file","compile-tests":"tsc -p . --outDir out","watch-tests":"tsc -p . -w --outDir out","pretest":"npm run compile-tests && npm run compile && npm run lint","lint":"eslint src","test":"vscode-test"},"devDependencies":{"@types/adm-zip":"^0.5.8","@types/find-process":"^1.1.0","@types/js-base64":"^3.0.0","@types/mocha":"^10.0.10","@types/node":"20.x","@types/sinon":"^17.0.4","@types/tar":"^6.1.13","@types/vscode":"^1.100.0","@typescript-eslint/eslint-plugin":"^8.28.0","@typescript-eslint/parser":"^8.28.0","@vscode/debugprotocol":"^1.68.0","@vscode/test-cli":"^0.0.10","@vscode/test-electron":"^2.4.1","eslint":"^9.23.0","sinon":"^21.0.0","ts-loader":"^9.5.2","typescript":"^5.8.2","webpack":"^5.98.0","webpack-cli":"^6.0.1"},"dependencies":{"@types/xml2js":"^0.4.14","@types/yauzl":"^2.10.3","adm-zip":"^0.5.17","applicationinsights":"^2.9.5","fdir":"^6.5.0","find-process":"^2.0.0","js-base64":"^3.7.8","jsonc-parser":"^3.3.1","monaco-editor":"^0.45.0","picomatch":"^4.0.5","tar":"^7.4.3","vscode-languageclient":"^9.0.1","xml-js":"^1.6.11","xml2js":"^0.6.2","yauzl":"^3.2.0"}},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCode/data/extensions/jaku