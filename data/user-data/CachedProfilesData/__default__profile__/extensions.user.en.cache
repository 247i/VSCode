e name from launchSettings.json"},"console":{"type":"string","enum":["integratedTerminal","internalConsole","externalTerminal"],"enumDescriptions":["VS Code's integrated terminal","VS Code's internal debug console","External terminal window"],"default":"integratedTerminal","description":"Console type for output"},"env":{"type":"object","additionalProperties":{"type":"string"},"description":"Environment variables to set for the process"},"args":{"type":"array","items":{"type":"string"},"description":"Command line arguments to pass to the program"},"cwd":{"type":"string","description":"Working directory for the project"},"url":{"type":"string","description":"URL for web projects (e.g., http://localhost:5000)"},"launchBrowser":{"type":"boolean","default":true,"description":"Whether to launch browser for web projects"},"setAsStartup":{"type":"boolean","default":false,"description":"Whether to set this project as the startup project"},"configuration":{"type":"string","enum":["Debug","Release"],"default":"Debug","description":"Build configuration"},"skipBuild":{"type":"boolean","default":false,"description":"Skip building before launch"},"enableHotReload":{"type":"boolean","default":false,"description":"Enable .NET Hot Reload using 'dotnet watch'. When enabled, allows live code changes during debugging."},"logging":{"type":"object","properties":{"moduleLoad":{"type":"boolean","default":false,"description":"Enable module load logging"}},"description":"Logging options"}}}},"initialConfigurations":[{"name":"C# Dev Tools: Launch","type":"devtools","request":"launch","projectPath":"${workspaceFolder}/src/MyProject/MyProject.csproj","withDebug":true}],"configurationSnippets":[{"label":"C# Dev Tools: Launch Project","description":"Launch a .NET project using C# Dev Tools","body":{"name":"Launch ${1:ProjectName}","type":"devtools","request":"launch","projectPath":"^\"\\${workspaceFolder}/${2:src/MyProject/MyProject.csproj}\"","withDebug":true}},{"label":"C# Dev Tools: Launch Web Project","description":"Launch an ASP.NET Core web project with browser opening","body":{"name":"Launch ${1:WebApp}","type":"devtools","request":"launch","projectPath":"^\"\\${workspaceFolder}/${2:src/WebApp/WebApp.csproj}\"","projectType":"web","withDebug":true,"launchBrowser":true,"url":"https://localhost:5001"}},{"label":"C# Dev Tools: Launch with Profile","description":"Launch using a specific launch profile from launchSettings.json","body":{"name":"Launch ${1:Project} (${2:Development})","type":"devtools","request":"launch","projectPath":"^\"\\${workspaceFolder}/${3:src/MyProject/MyProject.csproj}\"","launchProfile":"${2:Development}","withDebug":true}},{"label":"C# Dev Tools: Run Without Debugging","description":"Run a .NET project without the debugger attached","body":{"name":"Run ${1:ProjectName}","type":"devtools","request":"launch","projectPath":"^\"\\${workspaceFolder}/${2:src/MyProject/MyProject.csproj}\"","withDebug":false}}]},{"program":"extension/bin/Debugger/clrdbg","windows":{"program":"extension/bin/Debugger/clrdbg.exe"},"args":["--interpreter=vscode"],"type":"coreclr","label":".NET Core Debugger","languages":["csharp","fsharp","vb","razor","aspnetcorerazor","xml"],"configurationAttributes":{"launch":{"properties":{"program":{"type":"string"},"args":{"type":"array"},"cwd":{"type":"string"},"env":{"type":"object"},"console":{"type":"string","enum":["internalConsole","integratedTerminal","externalTerminal"]},"sourceFileMap":{"type":"object"},"justMyCode":{"type":"boolean"},"requireExactSource":{"type":"boolean"},"enableStepFiltering":{"type":"boolean"},"pipeTransport":{"type":"object"},"suppressJITOptimizations":{"type":"boolean"},"symbolOptions":{"type":"object"},"sourceLinkOptions":{"type":"object"},"launchSettingsFilePath":{"type":"string"},"launchSettingsProfile":{"type":"string"},"launchWebBrowser":{"type":"boolean"}}},"attach":{"properties":{"processId":{"type":"string"},"processPath":{"type":"string"},"sourceFileMap":{"type":"object"},"justMyC